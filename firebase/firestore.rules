rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function conversationRef(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function conversationExists(conversationId) {
      return exists(conversationRef(conversationId));
    }

    function conversationData(conversationId) {
      return get(conversationRef(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        conversationExists(conversationId) &&
        request.auth.uid in conversationData(conversationId).participantIds;
    }

    function isDirectConversationParticipantList() {
      return request.resource.data.type == "direct" &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.auth.uid in request.resource.data.participantIds;
    }

    function isGroupConversationParticipantList() {
      return request.resource.data.type == "group" &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() >= 3 &&
        request.resource.data.participantIds.size() <= 256 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.adminIds is list &&
        request.auth.uid in request.resource.data.adminIds &&
        request.resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && (!("phoneNumber" in request.resource.data) || request.resource.data.phoneNumber is string)
        && (!("email" in request.resource.data) || request.resource.data.email is string)
        && (!("photoUrl" in request.resource.data) || request.resource.data.photoUrl is string)
        && (!("lastSeenVisibility" in request.resource.data) || request.resource.data.lastSeenVisibility is string)
        && (!("profilePhotoVisibility" in request.resource.data) || request.resource.data.profilePhotoVisibility is string)
        && (!("readReceiptsEnabled" in request.resource.data) || request.resource.data.readReceiptsEnabled is bool)
        && request.resource.data.profileComplete == true;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /contacts/{ownerUserId}/items/{contactUserId} {
      allow read: if isOwner(ownerUserId) ||
        (isSignedIn() && request.auth.uid == contactUserId);
      allow create, update: if isOwner(ownerUserId)
        && ownerUserId != contactUserId
        && request.resource.data.userId == contactUserId
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && (!("phoneNumber" in request.resource.data) || request.resource.data.phoneNumber is string)
        && (!("photoUrl" in request.resource.data) || request.resource.data.photoUrl is string);
      allow delete: if isOwner(ownerUserId);
    }

    match /user_devices/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.token is string
        && request.resource.data.platform == "android";
      allow delete: if isOwner(userId);
    }

    match /blocked_users/{userId}/items/{blockedUserId} {
      allow read: if isOwner(userId) || (isSignedIn() && request.auth.uid == blockedUserId);
      allow create, update: if isOwner(userId)
        && userId != blockedUserId
        && request.resource.data.userId == blockedUserId;
      allow delete: if isOwner(userId);
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.status == "open";
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      function isOwnReadReceiptUpdate() {
        let oldReceipts = ("readAtByUser" in resource.data && resource.data.readAtByUser is map)
          ? resource.data.readAtByUser
          : {};
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAtByUser"])
          && request.resource.data.readAtByUser is map
          && request.resource.data.readAtByUser.diff(oldReceipts)
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.readAtByUser[request.auth.uid] == request.time;
      }

      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() &&
        (isDirectConversationParticipantList() || isGroupConversationParticipantList());
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.type == resource.data.type
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "lastMessageText", "lastMessageId", "lastMessageSenderId", "updatedAt"
          ]) ||
          isOwnReadReceiptUpdate() ||
          (
            resource.data.type == "group" &&
            request.auth.uid in resource.data.adminIds &&
            request.resource.data.createdBy == resource.data.createdBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "title", "photoUrl", "adminIds", "updatedAt"
            ])
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && (
            (
              request.resource.data.type == "text"
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
            ) ||
            (
              request.resource.data.type == "image"
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
              && (!("text" in request.resource.data) || request.resource.data.text is string)
            ) ||
            (
              request.resource.data.type == "document"
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 255
              && request.resource.data.mimeType is string
              && request.resource.data.mimeType in [
                "application/pdf",
                "text/plain",
                "application/msword",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              ]
              && request.resource.data.fileSizeBytes is int
              && request.resource.data.fileSizeBytes > 0
              && request.resource.data.fileSizeBytes <= 26214400
            ) ||
            (
              request.resource.data.type == "voice"
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.mimeType is string
              && request.resource.data.mimeType in ["audio/mp4", "audio/aac", "audio/mpeg", "audio/3gpp", "audio/ogg", "audio/wav", "audio/webm"]
              && request.resource.data.fileSizeBytes is int
              && request.resource.data.fileSizeBytes > 0
              && request.resource.data.fileSizeBytes <= 10485760
              && (!("durationMillis" in request.resource.data) || request.resource.data.durationMillis is number)
            )
          );
        allow update: if isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && (
            (
              request.resource.data.isDeleted == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "isDeleted", "deletedAt", "text", "mediaUrl", "mediaPublicId",
                "mediaProvider", "mimeType", "fileName", "fileSizeBytes"
              ])
            ) || (
              resource.data.type == "text"
              && (!("isDeleted" in resource.data) || resource.data.isDeleted != true)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
              && request.resource.data.editedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            )
          );
        allow delete: if false;
      }

      match /typing/{userId} {
        allow read: if isConversationParticipant(conversationId);
        allow create, update: if isConversationParticipant(conversationId)
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.isTyping is bool;
        allow delete: if false;
      }
    }

    match /calls/{callId} {
      function isCallParticipant() {
        return isSignedIn()
          && request.auth.uid in [resource.data.callerId, resource.data.receiverId];
      }

      function callIdentityIsUnchanged() {
        return request.resource.data.callerId == resource.data.callerId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isValidStatusUpdate() {
        let before = resource.data.status;
        let after = request.resource.data.status;
        return (
            (before == "ringing" && after == "accepted"
              && request.auth.uid == resource.data.receiverId
              && resource.data.answer == ""
              && request.resource.data.answer is string
              && request.resource.data.answer.size() > 0
              && request.resource.data.answer.size() <= 65536
              && request.resource.data.acceptedAt == request.time
              && request.resource.data.endedAt == resource.data.endedAt
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "answer", "acceptedAt"])) ||
            (before == "ringing" && after in ["rejected", "busy"]
              && request.auth.uid == resource.data.receiverId
              && request.resource.data.acceptedAt == resource.data.acceptedAt
              && request.resource.data.endedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "endedAt"])) ||
            (before == "ringing" && after == "cancelled"
              && request.auth.uid == resource.data.callerId
              && request.resource.data.acceptedAt == resource.data.acceptedAt
              && request.resource.data.endedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "endedAt"])) ||
            (before == "ringing" && after in ["missed", "timeout"]
              && request.resource.data.acceptedAt == resource.data.acceptedAt
              && request.resource.data.endedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "endedAt"])) ||
            (before == "accepted" && after == "ended"
              && request.resource.data.acceptedAt == resource.data.acceptedAt
              && request.resource.data.endedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "endedAt"]))
          );
      }

      function isValidIceCandidate() {
        return request.resource.data.keys().hasAll([
          "senderId", "sdpMid", "sdpMLineIndex", "candidate", "createdAt"
        ])
          && request.resource.data.keys().hasOnly([
            "senderId", "sdpMid", "sdpMLineIndex", "candidate", "createdAt"
          ])
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.sdpMid == null || request.resource.data.sdpMid is string)
          && request.resource.data.sdpMLineIndex is int
          && request.resource.data.sdpMLineIndex >= 0
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() > 0
          && request.resource.data.candidate.size() <= 4096
          && request.resource.data.createdAt == request.time;
      }

      allow read: if isCallParticipant();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          "callerId", "receiverId", "type", "status", "offer", "answer",
          "createdAt", "acceptedAt", "endedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "callerId", "receiverId", "type", "status", "offer", "answer",
          "createdAt", "acceptedAt", "endedAt"
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)/items/$(request.resource.data.receiverId))
        && !exists(/databases/$(database)/documents/blocked_users/$(request.resource.data.receiverId)/items/$(request.auth.uid))
        && request.resource.data.type in ["audio", "video"]
        && request.resource.data.status == "ringing"
        && request.resource.data.offer is string
        && request.resource.data.offer.size() > 0
        && request.resource.data.offer.size() <= 65536
        && request.resource.data.answer == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.endedAt == null;
      allow update: if isCallParticipant()
        && callIdentityIsUnchanged()
        && isValidStatusUpdate();
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isSignedIn()
          && request.auth.uid in [
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
            get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
          ];
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          && isValidIceCandidate();
        allow update, delete: if false;
      }

      match /receiverCandidates/{candidateId} {
        allow read: if isSignedIn()
          && request.auth.uid in [
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
            get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
          ];
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
          && isValidIceCandidate();
        allow update, delete: if false;
      }

    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
