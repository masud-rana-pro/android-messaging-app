# -----------------------------
# ContactMe Git Ignore Rules
# -----------------------------
# Keep source code, docs, learning notes, Firebase rules, scripts, and Gradle wrapper files in Git.
# Ignore only generated files, local machine settings, build outputs, and secrets.

# Android / Gradle generated files
.gradle/
.kotlin/
build/
**/build/

# Local Android Studio / SDK machine settings
local.properties
**/local.properties

# IDE user-specific files
.idea/
**/.idea/
*.iml

# Build artifacts
*.apk
*.ap_
*.aab
*.dex

# Kotlin / Java / Gradle logs
*.log
hs_err_pid*
replay_pid*

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets and signing files
.env
.env.*
cloudinary.properties
cloudinary.local.properties
scripts/cloudinary_onboarding.gradle.kts
*.keystore
*.jks
*.p12
*.pem

# Firebase / Google service config
# Keep these out until you intentionally decide how to manage environment-specific config.
google-services.json
GoogleService-Info.plist

# Temporary files
*.tmp
*.temp
*.swp
*.swo
~$*
